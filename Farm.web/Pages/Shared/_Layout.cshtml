<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <a asp-page="/Index" class="btn btn-success">Главная страница</a>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Моя Ферма</title>

    <!-- Подключение стилей -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/css/bootstrap.min.css" rel="stylesheet">
    <!--link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" /-->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/table.css" asp-append-version="true" />

    <link
        rel="stylesheet"
        href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
    />
</head>
<body>
<header>
    <!-- Навигация -->
</header>

<main role="main" class="container">
    @RenderBody()
</main>

<footer>
    <p>&copy; 2025 - Моя Ферма</p>
    <a asp-page="/Report/Daily">Отчет</a>
</footer>
<form method="post" asp-page="/Account/Logout" style="display:inline">
    <button type="submit" class="btn btn-outline-success">Выйти</button>
</form>

<!-- Подключение скриптов -->
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
<script src="~/js/form.js" asp-append-version="true"></script>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

@RenderSection("Scripts", required: false)
@section Scripts {
<partial name="_ValidationScriptsPartial" />
}
</body>
</html>