@page
@model DailyModel
@using Microsoft.AspNetCore.Mvc.Rendering

<h2>Отчёт за период</h2>

<form method="post" asp-page-handler="Form">
    <div class="form-group">
        <label>Дата с:</label>
        <input asp-for="Filter.FromDate" class="form-control" type="date" />
        <span asp-validation-for="Filter.FromDate" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label>Дата по:</label>
        <input asp-for="Filter.ToDate" class="form-control" type="date" />
        <span asp-validation-for="Filter.ToDate" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label>Пользователь:</label>
        <select asp-for="Filter.UserId" asp-items="Model.Filter.Users" class="form-control">
            <option value="">Все пользователи</option>
        </select>
    </div>

    <div class="form-group mt-3">
        <!-- Сформировать отчет -->
        <button type="submit" class="btn btn-primary">Сформировать отчет</button>

        <!-- Отправить на почту -->
        <button type="submit" class="btn btn-warning" asp-page-handler="SendEmail">Отправить на почту</button>

        <!-- Скачать PDF -->
        <button type="submit" class="btn btn-success" asp-page-handler="Download">Скачать PDF</button>
    </div>
</form>

@if (Model.Filter.Results.Any())
{
<h3>Результаты:</h3>
<table class="table table-bordered table-striped">
    <thead>
    <tr>
        <th>ID Пользователя</th>
        <th>Имя пользователя</th>
        <th>Продукт</th>
        <th>Количество</th>
        <th>Единицы</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var item in Model.Filter.Results)
    {
    <tr>
        <td>@item.UserId</td>
        <td>@item.UserName</td>
        <td>@item.ProductName</td>
        <td>@item.Quantity</td>
        <td>@item.UnitName</td>
    </tr>
    }
    </tbody>
</table>
}
