@page
@model Farm.Web.Pages.Users.IndexModel
@{
    ViewData["Title"] = "Пользователи";
}

<div class="d-flex justify-content-between mb-3">
    <h2>Список пользователей</h2>
    <a asp-page="Create" class="btn btn-primary">Добавить пользователя</a>
</div>

<table class="table table-striped">
    <thead>
    <tr>
        <th>ID</th>
        <th>Имя</th>
        <th>Email</th>
        <th>Роль</th>
        <th>Действия</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var user in Model.Users)
    {
        <tr>
            <td>@user.Id</td>
            <td>@user.UserName</td>
            <td>@user.Email</td>
            <td>@user.RoleId</td>
            <td>
                <a asp-page="./Edit" asp-route-id="@user.Id" class="btn btn-sm btn-warning">Изменить</a>
                <form method="post" asp-page-handler="Delete" asp-route-id="@user.Id" class="d-inline">
                    <button type="submit" class="btn btn-sm btn-danger">Удалить</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>